              <calculation class='tableau' formula='IF ATTR([LinPack_923155276951376517]) &lt;= [Parameters].[LinPack_268298139370622864] THEN &#13;&#10;CASE [Parameters].[LinPack_949819255619347265] &#13;&#10;WHEN &quot;CM_vs_PM&quot; THEN NULL &#13;&#10;WHEN &quot;CM_vs_PY&quot; THEN [LinPack_510355836833109480] &#13;&#10;WHEN &quot;ACT_vs_TGT&quot; THEN NULL &#13;&#10;WHEN &quot;CYTD_vs_PYTD&quot; THEN [LinPack_016302200971301910] &#13;&#10;WHEN &quot;YTDACT_vs_YTDTGT&quot; THEN NULL &#13;&#10;WHEN &quot;NONE&quot;  THEN NULL &#13;&#10;END &#13;&#10;END'>
                <table-calc ordering-type='Rows' />
