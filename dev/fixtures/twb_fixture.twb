    <worksheet name='Total Sales Estimated (for Selected Business Line)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Regular' fontsize='7'>ACTUAL Total Sales</run>
            <run bold='true' fontalignment='1' fontcolor='#032d60' fontname='Tableau Regular' fontsize='7'>Æ </run>
            <run bold='true' fontalignment='1' fontname='Tableau Regular' fontsize='7'>&amp;</run>
            <run bold='true' fontalignment='1' fontcolor='#032d60' fontname='Tableau Regular' fontsize='7'>Æ </run>
            <run bold='true' fontalignment='1' fontcolor='#75a1c7' fontname='Tableau Regular' fontsize='7'>ESTIMATE</run>
          </formatted-text>
        </title>
