              <calculation class='tableau' formula='CASE [Parameters].[LinPack_949819255619347265] &#13;&#10;WHEN &quot;CM_vs_PM&quot; THEN [LinPack_062328442607865390] &#13;&#10;WHEN &quot;CM_vs_PY&quot; THEN [LinPack_062328442607865390] &#13;&#10;WHEN &quot;ACT_vs_TGT&quot; THEN  [LinPack_062328442607865390] &#13;&#10;WHEN &quot;CYTD_vs_PYTD&quot; THEN [LinPack_904808430254748104] &#13;&#10;WHEN &quot;YTDACT_vs_YTDTGT&quot; THEN [LinPack_904808430254748104]  &#13;&#10;WHEN &quot;NONE&quot;  THEN NULL &#13;&#10;END' />
              <desc>
