    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Product Line'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#2b5c8a' fontsize='10'><![CDATA[<[Parameters].[LinPack_562938394552513421]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontname='Tableau Semibold' fontsize='24'>Product Line Deep-dive</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_243' value='top' />
          <format attr='vertical-align' id='dash-text_244' value='top' />
          <format attr='vertical-align' id='dash-text_245' value='top' />
