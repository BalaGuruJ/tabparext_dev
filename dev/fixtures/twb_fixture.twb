          <formatted-text>
            <run fontcolor='#2b5c8a' fontname='Tableau Medium' fontsize='10'><![CDATA[Which <[Parameters].[pSelect Store or Business Line (copy)_845550866685894659]>s drive our sales ]]></run>
            <run fontcolor='#032d60' fontname='Tableau Medium' fontsize='10'>growth</run>
            <run fontcolor='#2b5c8a' fontname='Tableau Medium' fontsize='10'>/</run>
            <run fontcolor='#c85200' fontname='Tableau Medium' fontsize='10'>decline</run>
            <run fontcolor='#2b5c8a' fontname='Tableau Medium' fontsize='10'>?</run>
            <run>Æ&#10;</run>
            <run fontsize='7' italic='true'><![CDATA[    Shows how much each <[Parameters].[pSelect Store or Business Line (copy)_845550866685894659]> contributed to Total Sales. The color of a circle indicates whether the sales of the <[Parameters].[pSelect Store or Business Line (copy)_845550866685894659]> have increased (blue) or decreased (orange), its size indicating the magnitude of the change.]]></run>
            <run>Æ&#10;</run>
            <run fontsize='7' italic='true'>Æ    </run>
            <run bold='true' fontcolor='#c85200' fontsize='7' italic='true'>Large Orange Circles are highest sales declines</run>
            <run fontsize='7' italic='true'> vs </run>
            <run bold='true' fontcolor='#032d60' fontsize='7' italic='true'>Large Blue Circles are highest sales growth</run>
            <run fontsize='7' italic='true'>.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
